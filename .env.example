# ==============================================================================
# LUMOS CRM & ERP — ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Supabase Credentials
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Payme Merchant Integration (Obtain from Payme Business Merchant Cabinet)
# Merchant URL: https://business.payme.uz
VITE_PAYME_MERCHANT_ID=your_payme_merchant_id
# Note: Secret key is ONLY set on Supabase Edge Function Secrets via:
# supabase secrets set PAYME_SECRET_KEY=your_payme_secret_key

# Click Merchant Integration (Obtain from Click Merchant Cabinet)
# Merchant URL: https://merchant.click.uz
VITE_CLICK_SERVICE_ID=your_click_service_id
VITE_CLICK_MERCHANT_ID=your_click_merchant_id
# Note: Secret key is ONLY set on Supabase Edge Function Secrets via:
# supabase secrets set CLICK_SECRET_KEY=your_click_secret_key
